# Laptop Compose defaults. scripts/quickstart.sh writes a real .env with
# random secrets. If you copy this file, replace every change-me value.
# Production hostnames: docs/deploy-aws.md
POSTGRES_PASSWORD=change-me-local-postgres-password-32ch
BETTER_AUTH_SECRET=change-me-local-better-auth-secret-32
BLAKTAIL_AUTH_HMAC_SECRET=change-me-local-auth-hmac-secret-32
BLAKTAIL_RELAY_AUTH_SECRET=change-me-local-relay-hmac-secret-32
BLAKTAIL_DIAGNOSTICS_TOKEN=change-me-local-diagnostics-token-32
BLAKTAIL_RELAY_ENDPOINT=127.0.0.1:3478
BETTER_AUTH_URL=http://localhost:3000
# Reverse proxies in front of the console that append to X-Forwarded-For.
# Keep 0 while port 3000 is reachable directly; see docs/configuration.md.
BLAKTAIL_TRUSTED_PROXY_HOPS=0
BLAKTAIL_REGION=ap-southeast-2
# Optional. scripts/quickstart.sh sets this for a remote Docker host.
# BLAKTAIL_TLS_EXTRA_SAN=DNS:homelab,IP:192.168.1.19
