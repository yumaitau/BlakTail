{
  "name": "@blaktail/console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "bootstrap": "bun scripts/bootstrap.mjs",
    "test": "bun test scripts/*.test.mjs",
    "test:auth-e2e": "bun scripts/http-auth-e2e.mjs",
    "test:ui": "bun scripts/lightpanda-ui.mjs",
    "test:journey": "bun scripts/user-journey-e2e.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.62.1",
    "typescript": "~5.9.0"
  }
}
